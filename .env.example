# ============================================================================
# VARIABLES DE ENTORNO - NUESTRO UNIVERSO (JONATHAN & RIHAM 💖)
# ============================================================================
# Si utilizas Netlify, Vercel u otro servicio de hosting, puedes definir
# estas variables en la sección de "Environment Variables":
#
# En Netlify: Site configuration -> Environment variables -> Add a variable
# ============================================================================

# URL de tu proyecto Supabase (Dashboard -> Settings -> API -> Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (Dashboard -> Settings -> API -> Project API Keys -> anon public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key_de_supabase

# Proveedor activo ("supabase" | "firebase" | "instant_love")
AUTH_PROVIDER=supabase
